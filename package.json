{
  "name": "satelital-radio",
  "version": "1.0.1",
  "private": true,
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "NODE_ENV=production next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:streams": "node scripts/check-streams.mjs",
    "test:browser": "playwright test",
    "audit:deps": "npm audit --audit-level=high"
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "hls.js": "^1.7.4",
    "lucide-react": "^1.14.0",
    "next": "^15.1.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.1",
    "@types/node": "^20.14.0",
    "@types/react": "18.2.27",
    "autoprefixer": "^10.4.20",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.23",
    "typescript": "5.2.2",
    "vitest": "5.1.1"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
